{
  "name": "vragenlijst-microsoft-365-copilot",
  "version": "1.0.0",
  "private": true,
  "description": "Webformulier 'Vragenlijst Microsoft 365 Copilot' in Driessen Groep-huisstijl, inclusief beheerdersomgeving met automatische beoordeling volgens het beoordelingsmodel.",
  "main": "src/server.js",
  "type": "commonjs",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "migrate": "node src/db/migrate.js",
    "test": "node --test test/*.test.js",
    "build:static": "node tools/bouw-statisch.js",
    "herbereken": "node tools/herbereken.js"
  },
  "dependencies": {
    "better-sqlite3": "^11.5.0",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "express-rate-limit": "^7.4.1",
    "knex": "^3.1.0",
    "mysql2": "^3.11.5",
    "nodemailer": "^10.0.10",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "smtp-server": "^3.19.13"
  }
}
