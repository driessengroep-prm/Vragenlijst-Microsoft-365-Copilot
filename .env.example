# ---------------------------------------------------------------------------
# Vragenlijst Microsoft 365 Copilot - configuratie
# Kopieer dit bestand naar `.env` en vul je eigen waarden in.
# ---------------------------------------------------------------------------

# Webserver
PORT=3000
HOST=0.0.0.0
NODE_ENV=production
# Zet op true als de app achter een reverse proxy (nginx, IIS, Traefik) draait.
TRUST_PROXY=false

# ---------------------------------------------------------------------------
# Database
# DB_CLIENT: postgres | mysql | mariadb | mssql | sqlite
#
# sqlite   -> alleen bedoeld om lokaal te testen, geen extra software nodig.
# postgres | mysql | mariadb | mssql -> jouw eigen lokale database.
# ---------------------------------------------------------------------------
DB_CLIENT=sqlite

# Alleen voor DB_CLIENT=sqlite
DB_FILE=./data/vragenlijst.sqlite

# Voor alle andere databases (vul in zodra je de gegevens hebt):
#DB_HOST=127.0.0.1
#DB_PORT=5432
#DB_USER=copilot
#DB_PASSWORD=
#DB_NAME=copilot
#DB_SSL=false
#DB_SSL_STRICT=true

# Als alternatief voor bovenstaande velden kun je één connectiestring opgeven:
#DB_URL=postgres://gebruiker:wachtwoord@127.0.0.1:5432/copilot

# Naam van de tabel waarin de inzendingen komen te staan.
DB_TABLE=copilot_aanvragen
# Alleen voor PostgreSQL/MSSQL: het schema waarin de tabel staat.
#DB_SCHEMA=public

# ---------------------------------------------------------------------------
# Beheerdersomgeving (/beheer)
# Zonder ADMIN_PASSWORD is de beheerdersomgeving uitgeschakeld.
# ---------------------------------------------------------------------------
ADMIN_USER=beheerder
ADMIN_PASSWORD=

# ---------------------------------------------------------------------------
# Formulier
# ---------------------------------------------------------------------------
# Maximaal aantal inzendingen per IP-adres per kwartier.
RATE_LIMIT=5
# Bewaar een onomkeerbare hash van het IP-adres (voor misbruikdetectie).
BEWAAR_IP_HASH=true
IP_HASH_SALT=verander-dit-in-een-eigen-willekeurige-string
